# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults shown)
# GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
# GEMMA_RETRIES_PER_MODEL=2
# GEMMA_BASE_DELAY_S=1.0
# GEMMA_TIMEOUT_S=30

# Daraja sandbox only. Keep these values in .env; never commit real credentials.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=https://your-public-host/api/mpesa/callback
#
# Legacy names are also supported if already present in your .env:
# CONSUMER_KEY=
# CONSUMER_SECRET=
# PASSKEY=
# SHORT_CODE=
# CALLBACK_URL=https://your-public-host/api/mpesa/callback
